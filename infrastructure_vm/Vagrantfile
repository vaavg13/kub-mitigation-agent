# -*- mode: ruby -*-
# vi: set ft=ruby :

# -----------------------------------------------------------------------------
# Configuration Variables
# -----------------------------------------------------------------------------
# Base OS Box: Uses stable Ubuntu 22.04 LTS
NODE_BOX = "generic/ubuntu2204"
# Private Network CIDR and IP base for the k3s-net libvirt network
IP_BASE = "192.168.100."

# --- HOST CPU THREAD PINNING CONFIGURATION (PAIRED) ---
# Your 8 isolated physical cores, represented by their 16 SMT threads
# Primary threads (Cores)
PRIMARY_CORES = [16, 17, 18, 19, 20, 21, 22, 23]
# SMT threads (Partners of the primary cores)
SMT_THREADS   = [40, 41, 42, 43, 44, 45, 46, 47]
# ------------------------------------------------------

# Worker tier definitions:
# [prefix, count, vcpus, memory_mb, physical_cores_per_vm, zone]
NODE_TIERS = [
  # Tier 1: Cloud Workers (2 nodes)
  # 2 physical cores each = 4 vCPUs (4 host threads)
  { prefix: "cloud-worker", count: 2, cpus: 4, memory: 4096, physical_cores_per_vm: 2, zone: "cloud" },
  
  # Tier 2: Edge Workers (4 nodes)
  # 1 physical core each = 2 vCPUs (2 host threads)
  # Distributed across 2 edge sites (2 workers per site)
  { prefix: "edge-worker",  count: 4, cpus: 2, memory: 2048, physical_cores_per_vm: 1, zone_template: "edge-site" }
]
# -----------------------------------------------------------------------------


Vagrant.configure("2") do |config|
  config.vm.box = NODE_BOX
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.insert_key = false

  # Tracks the current physical core index (0=core 16/40, 1=core 17/41, etc.)
  $core_index = 0

  # Helper function to configure the libvirt provider with CPU settings
  def configure_libvirt(vm_config, cpus, memory, cpuset_value=nil)
    vm_config.vm.provider "libvirt" do |libvirt|
      libvirt.memory = memory
      libvirt.cpus = cpus
      # Only apply cpuset if a value is provided (i.e., for workers)
      libvirt.cpuset = cpuset_value if cpuset_value
    end
  end

  # ---------------------------------------------------------------------------
  # 1. K3s Server Node (Control Plane - UNPINNED)
  # ---------------------------------------------------------------------------
  config.vm.define "k3s-server", primary: true do |server|
    server.vm.hostname = "k3s-server"
    server_ip = "#{IP_BASE}10"
    server.vm.network :private_network, ip: server_ip, libvirt__network_name: "k3s-net"

    # Server resources: 2 vCPUs, 2048MB RAM. NO CPUSET.
    # This allows the host scheduler to place the VM on non-isolated cores (0-15, etc.)
    configure_libvirt(server, 2, 2048)
    
    server.vm.provision "shell", privileged: true, inline: <<-SHELL
      echo "--- System Preparation (Server) ---"
      sudo swapoff -a
      sudo sed -i '/ swap / s/^/#/' /etc/fstab
      
      echo "--- Installing K3s Server (Control Plane) ---"
      curl -sfL https://get.k3s.io | sh -s - server \
        --cluster-init \
        --write-kubeconfig-mode "644" \
        --tls-san #{server_ip}
      
      echo "--- Waiting for K3s Server to be ready..."
      # Wait for K3s to be ready (important for agent connection)
      timeout 300 bash -c 'until sudo kubectl get nodes 2>/dev/null; do sleep 1; done'
      echo "K3s Server is READY."
      
      # Make kubeconfig readable for vagrant user (for easier debugging)
      sudo chmod 644 /etc/rancher/k3s/k3s.yaml
    SHELL
  end

  # ---------------------------------------------------------------------------
  # 2. Worker Nodes (Multi-Tier Deployment - PINNED to isolated cores)
  # ---------------------------------------------------------------------------
  node_ip_counter = 20

  NODE_TIERS.each do |tier|
    (1..tier[:count]).each do |i|
      node_name = "#{tier[:prefix]}-#{i}"
      # Assign IPs sequentially starting from .20 (192.168.100.20, .21, etc.)
      node_ip = "#{IP_BASE}#{node_ip_counter}"

      # Determine zone for this node
      zone = if tier[:zone]
               tier[:zone]
             elsif tier[:zone_template]
               # Distribute edge workers across sites (2 per site)
               site_num = ((i - 1) / 2) + 1
               "#{tier[:zone_template]}-#{site_num}"
             else
               "default"
             end

      config.vm.define node_name, autostart: false do |worker|
        worker.vm.hostname = node_name
        worker.vm.network :private_network, ip: node_ip, libvirt__network_name: "k3s-net"

        # --- Calculate CPU pinning for this node based on SMT pairing ---
        pin_threads = []
        
        # This inner loop grabs the required number of physical core pairs
        (1..tier[:physical_cores_per_vm]).each do
          # Check if we have enough cores left in the array
          if $core_index < PRIMARY_CORES.length
            # Add the primary thread (e.g., 16)
            pin_threads << PRIMARY_CORES[$core_index]
            # Add its SMT partner thread (e.g., 40)
            pin_threads << SMT_THREADS[$core_index]
            
            # Advance the index tracker to the next physical core
            $core_index += 1
          else
            # This should not happen if math is correct, but good to have a warning
            puts "WARNING: Ran out of isolated cores to pin!"
          end
        end
        
        pin_cores_string = pin_threads.join(',')
        
        # --- VERIFICATION LOGIC ---
        # cloud-worker-1: 4 vCPUs. Runs 2x. 
        #   Loop 1: $core_index=0. pin_threads=[16, 40]. $core_index=1
        #   Loop 2: $core_index=1. pin_threads=[16, 40, 17, 41]. $core_index=2
        #   Result: cpuset="16,40,17,41"
        #
        # cloud-worker-2: 4 vCPUs. Runs 2x.
        #   Loop 1: $core_index=2. pin_threads=[18, 42]. $core_index=3
        #   Loop 2: $core_index=3. pin_threads=[18, 42, 19, 43]. $core_index=4
        #   Result: cpuset="18,42,19,43"
        #
        # edge-worker-1: 2 vCPUs. Runs 1x.
        #   Loop 1: $core_index=4. pin_threads=[20, 44]. $core_index=5
        #   Result: cpuset="20,44"
        #
        # ...and so on for edge-worker-2, 3, 4.
        
        configure_libvirt(worker, tier[:cpus], tier[:memory], pin_cores_string)
        
        # Provisioning: Install K3s agent
        worker.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "--- System Preparation (Agent #{node_name}) ---"
          sudo swapoff -a
          sudo sed -i '/ swap / s/^/#/' /etc/fstab

          if ! command -v sshpass >/dev/null 2>&1; then
            echo "--- Installing sshpass for token retrieval ---"
            sudo apt-get update -y
            sudo apt-get install -y sshpass
          fi

          echo "--- Joining K3s Agent: #{node_name} to server #{IP_BASE}10 ---"
          
          # Server is guaranteed to be up (due to autostart: false and orchestration)
          # Fetch token with shorter timeout
          SERVER_IP="#{IP_BASE}10"
          K3S_TOKEN=""
          MAX_ATTEMPTS=30
          ATTEMPT=0
          
          until [ -n "$K3S_TOKEN" ] || [ $ATTEMPT -ge $MAX_ATTEMPTS ]; do
            echo "Attempt $((ATTEMPT+1))/$MAX_ATTEMPTS: Fetching K3s token from server..."
            
            if ping -c 1 -W 2 $SERVER_IP >/dev/null 2>&1; then
              K3S_TOKEN=$(sshpass -p vagrant ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 \
                              vagrant@$SERVER_IP \
                              "sudo cat /var/lib/rancher/k3s/server/node-token" 2>/dev/null | tr -d '\r')
              
              if [ -n "$K3S_TOKEN" ]; then
                echo "✓ Token acquired via SSH"
                break
              fi
            fi
            
            ATTEMPT=$((ATTEMPT+1))
            sleep 3
          done
          
          if [ -z "$K3S_TOKEN" ]; then
            echo "ERROR: Failed to acquire token after $MAX_ATTEMPTS attempts"
            exit 1
          fi

          echo "Installing K3s agent and joining cluster..."
          curl -sfL https://get.k3s.io | K3S_URL=https://$SERVER_IP:6443 K3S_TOKEN=$K3S_TOKEN sh -s - agent
          
          echo "✓ Agent installation complete for #{node_name} (zone: #{zone})"
        SHELL
      end

      node_ip_counter += 1
    end
  end
end


