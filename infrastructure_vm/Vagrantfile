# -*- mode: ruby -*-
# vi: set ft=ruby :

# -----------------------------------------------------------------------------
# Configuration Variables
# -----------------------------------------------------------------------------
# Base OS Box: Uses stable Ubuntu 22.04 LTS
NODE_BOX = "generic/ubuntu2204"

# Load node configuration from JSON
require "json"

CLUSTER_CONFIG_PATH = File.expand_path("config/cluster.json", __dir__)
CLUSTER_CONFIG = JSON.parse(File.read(CLUSTER_CONFIG_PATH))
NETWORK_CONFIG = CLUSTER_CONFIG.fetch("network")
IP_BASE = NETWORK_CONFIG.fetch("ip_base")

NODE_DEFINITIONS = CLUSTER_CONFIG.fetch("nodes")

SERVER_NODE      = NODE_DEFINITIONS.find { |node| (node["role"] || "worker") == "server" }
SERVER_IP_SUFFIX = SERVER_NODE ? SERVER_NODE.fetch("ip_suffix") : 10
SERVER_IP        = "#{IP_BASE}#{SERVER_IP_SUFFIX}"


Vagrant.configure("2") do |config|
  config.vm.box = NODE_BOX
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.insert_key = false

  # Helper function to configure the libvirt provider with CPU settings
  def configure_libvirt(vm_config, cpus, memory, cpuset_value=nil)
    vm_config.vm.provider "libvirt" do |libvirt|
      libvirt.memory = memory
      libvirt.cpus = cpus
      # Only apply cpuset if a value is provided (i.e., for workers)
      libvirt.cpuset = cpuset_value if cpuset_value
    end
  end

  # ---------------------------------------------------------------------------
  # Node Definitions (Control Plane + Workers)
  # ---------------------------------------------------------------------------

  NODE_DEFINITIONS.each do |node|
    node_name = node.fetch("name")
    node_ip = "#{IP_BASE}#{node.fetch("ip_suffix")}" 
    zone = node.fetch("zone", "default")
    role = (node["role"] || "worker").to_sym
    primary = node.fetch("primary", false)
    autostart = node.fetch("autostart", false)
    cpuset_list = node.fetch("cpuset", [])
    cpuset_value = cpuset_list.empty? ? nil : cpuset_list.join(",")

    config.vm.define node_name, primary: primary, autostart: autostart do |vm|
      vm.vm.hostname = node_name
      vm.vm.network :private_network, ip: node_ip, libvirt__network_name: "k3s-net"

      configure_libvirt(vm, node.fetch("cpus"), node.fetch("memory"), cpuset_value)

      if role == :server
        vm.vm.provision "shell", privileged: true,
          path: File.join(__dir__, "provision/server.sh"),
          args: [node_ip]
      else
        vm.vm.provision "shell", privileged: true,
          path: File.join(__dir__, "provision/worker.sh"),
          args: [node_name, SERVER_IP, zone]
      end

    end
  end
end