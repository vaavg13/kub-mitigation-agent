{
    "Name": "Hotel Reservation",
    "Namespace": "hotel-reservation",
    "Desc": "A hotel reservation application built with Go and gRPC, providing backend in-memory and persistent databases, a recommender system for hotel recommendations, and a functionality to place reservations.",
    "Supported Operations": [
        "Get profile and rates of nearby hotels available during given time periods",
        "Recommend hotels based on user provided metrics",
        "Place reservations"
    ],
    "Helm Config": {
        "release_name": "hotel-reservation",
        "chart_path": "hotelreservation",
        "namespace": "hotel-reservation"
    },
    "Critical Services": [
        "frontend",
        "search",
        "geo",
        "rate",
        "profile",
        "recommendation",
        "user",
        "reservation"
    ],
    "Workload": {
        "profile": "hotel_reservation",
        "host": "http://localhost:8080",
        "default_users": 10,
        "spawn_rate": 2,
        "wait_time_min": 1,
        "wait_time_max": 3
    },
    "Experiment": {
        "test_settings": {
            "deploy_fresh_app": true
        },
        "warmup_duration": 10,
        "baseline_duration": 30,
        "chaos_warmup_duration": 30,
        "recovery_duration": 30,
        "batch_settings": {
            "random_seed": 420
        },
        "chaosd": {
            "port": 31767
        }
    },
    "Istio Injection": true,
    "frontend_service": "frontend",
    "frontend_port": 5000
}
